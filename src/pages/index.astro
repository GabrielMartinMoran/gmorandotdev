---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import AgentSkillCard from '../components/AgentSkillCard.astro';
import BrandMark from '../components/BrandMark.astro';
import CosmicArt from '../components/CosmicArt.astro';
import { projects } from '../data/projects';
import { agentSkills, agentSkillsRepository } from '../data/agent-skills';

const title = 'Engineering in the open';
const description = 'Open source engineering projects by Gabriel Martín Moran: durable memory for AI workflows, agent orchestration, and practical software engineering.';
---

<SiteLayout title={title} description={description} titleKey="home.titleTag" descriptionKey="home.description">
  <div class="site-shell">
    <SiteHeader />
    <main>
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="hero-kicker"><span class="live-dot"></span> <span data-i18n="hero.kicker">COMPUTER ENGINEER · BUENOS AIRES</span></p>
          <h1 id="hero-title" data-i18n-html="hero.title">Software for<br />people who <em>build.</em></h1>
          <p class="hero-intro" data-i18n="hero.description">I’m Gabriel. I build open source software to solve engineering problems and share what I learn along the way.</p>
          <a class="hero-link" href="#proyectos"><span data-i18n="hero.link">Explore projects</span> <span aria-hidden="true">↓</span></a>
        </div>
        <CosmicArt />
        <div class="hero-index"><span>01 — 02</span><span data-i18n="hero.scroll">SCROLL</span></div>
      </section>

      <section class="projects-section" id="proyectos" aria-labelledby="projects-title">
        <div class="wrap">
          <div class="section-heading">
            <div>
              <p class="eyebrow" data-i18n="projects.eyebrow">GITHUB / PUBLIC REPOSITORIES</p>
              <h2 id="projects-title" data-i18n-html="projects.title">Systems <span>in progress.</span></h2>
            </div>
            <p class="section-aside" data-i18n-html="projects.aside">Real problems. Open source.<br />Engineering decisions in the repo.</p>
          </div>
          <div class="project-grid">
            {projects.map((project) => <ProjectCard project={project} />)}
          </div>
          <div class="projects-foot"><span data-i18n="projects.footerStatus">OPEN SOURCE · WORK IN PROGRESS</span><span><span data-i18n="projects.footerCount">02 REPOSITORIES</span> <i>✳</i></span></div>
        </div>
      </section>

      <section class="skills-section" id="skills" aria-labelledby="skills-title">
        <div class="wrap">
          <div class="section-heading skills-heading">
            <div>
              <p class="eyebrow" data-i18n="skills.eyebrow">AGENT TOOLKIT / REUSABLE WORKFLOWS</p>
              <h2 id="skills-title" data-i18n-html="skills.title">Skills for <span>your agent.</span></h2>
            </div>
            <div class="skills-intro">
              <p data-i18n="skills.description">Install focused instructions and workflows from my public skills repo. They activate when an agent’s task matches.</p>
              <a class="text-link" href={agentSkillsRepository} target="_blank" rel="noreferrer"><span data-i18n="skills.repoLink">Browse all skills</span> <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <div class="skill-grid">
            {agentSkills.map((skill, index) => <AgentSkillCard skill={skill} index={index} />)}
          </div>
          <div class="projects-foot"><span>npx skills add</span><span data-i18n="skills.count">06 SKILLS AVAILABLE</span></div>
        </div>
      </section>

      <section class="about-section wrap" id="sobre-mi" aria-labelledby="about-title">
        <div class="about-side">
          <p class="eyebrow" data-i18n="about.eyebrow">ENGINEER PROFILE</p>
          <span class="about-number" data-i18n="about.meta">PROFILE / ENGINEERING</span>
        </div>
        <div class="about-copy">
          <h2 id="about-title" data-i18n-html="about.title">Computer engineer, <em>building in public.</em></h2>
          <p data-i18n="about.body">I’m 31 years old, a computer engineer with over 10 years in the software industry. I advocate for good engineering practices: DDD, Clean Architecture, Clean Code, and systems that stay understandable as they grow.</p>
          <div class="profile-links">
            <a class="text-link" href="https://github.com/GabrielMartinMoran" target="_blank" rel="noreferrer"><span data-i18n="about.link">Find me on GitHub</span> <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="https://www.linkedin.com/in/gabriel-martín-moran-a8220b125" target="_blank" rel="noreferrer"><span data-i18n="about.linkedin">LinkedIn profile</span> <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="https://x.com/Gabriel_M_Moran" target="_blank" rel="noreferrer"><span data-i18n="about.x">X profile</span> <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="https://www.reddit.com/user/GabrielMartinMoran/" target="_blank" rel="noreferrer"><span data-i18n="about.reddit">Reddit profile</span> <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="mailto:moran.gabriel.95@gmail.com"><span>moran.gabriel.95@gmail.com</span> <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="about-stamp" aria-hidden="true"><span>GM / DEV<br /><b>NOTES</b></span><i>✳</i></div>
      </section>
    </main>
    <footer class="site-footer wrap">
      <a class="wordmark" href="/" aria-label="Back to home" data-i18n-aria="brand.backLabel"><span class="wordmark-mark"><BrandMark /></span><span>GABRIEL MARTÍN MORAN</span></a>
      <span data-i18n="footer.meta">BUENOS AIRES, AR · SOURCE: PUBLIC</span>
      <a href="#hero-title"><span data-i18n="footer.top">BACK TO TOP</span> ↑</a>
    </footer>
  </div>
</SiteLayout>
