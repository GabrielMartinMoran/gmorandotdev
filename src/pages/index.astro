---
import SiteLayout from '../layouts/SiteLayout.astro';
import HomePage from '../components/HomePage.astro';
import { getCopy } from '../data/ui-copy';
import { getHomeStructuredData, getLocaleUrls } from '../data/seo';

const localeUrls = getLocaleUrls();
const structuredData = getHomeStructuredData();
---

<SiteLayout
  title={getCopy('en', 'home.titleTag')!}
  description={getCopy('en', 'home.description')!}
  titleKey="home.titleTag"
  descriptionKey="home.description"
  locale="auto"
  alternateUrls={localeUrls}
  structuredData={structuredData}
>
  <HomePage locale="auto" localeUrls={localeUrls} />
</SiteLayout>
