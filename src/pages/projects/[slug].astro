---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import BrandMark from '../../components/BrandMark.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const nextProject = projects[(projects.findIndex((item) => item.slug === project.slug) + 1) % projects.length];
---

<SiteLayout
  title={project.name}
  description={project.summary.en}
  titleKey={`projects.${project.slug}.titleTag`}
  descriptionKey={`projects.${project.slug}.summary`}
>
  <div class={`site-shell project-page ${project.accent}`}>
    <SiteHeader />
    <main>
      <div class="wrap project-breadcrumb"><a href="/"><span data-i18n="project.breadcrumbHome">HOME</span></a><span>/</span><a href="/#proyectos"><span data-i18n="project.breadcrumbProjects">PROJECTS</span></a><span>/</span><span>{project.number}</span></div>
      <section class="project-hero wrap">
        <div class="project-title-block">
          <p class="hero-kicker"><span class="live-dot"></span> <span data-i18n={`projects.${project.slug}.eyebrow`}>{project.eyebrow.en}</span></p>
          <h1>{project.name}<span class="title-period">.</span></h1>
          <p class="project-lede" data-i18n={`projects.${project.slug}.summary`}>{project.summary.en}</p>
          <div class="project-actions">
            <a class="button button-dark" href={project.url} target="_blank" rel="noreferrer"><span data-i18n="project.github">View on GitHub</span> <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#overview"><span data-i18n="project.read">About this project</span> <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <div class="project-graphic" aria-hidden="true">
          <div class="graphic-grid"></div>
          <div class="graphic-ring ring-large"></div>
          <div class="graphic-ring ring-small"></div>
          <span class="graphic-mark">{project.mark}</span>
          <span class="graphic-caption">{project.number} / <span data-i18n="project.graphicCaption">SYSTEMS IN MOTION</span></span>
          <i class="graphic-dot dot-one"></i><i class="graphic-dot dot-two"></i><i class="graphic-dot dot-three"></i>
        </div>
      </section>
      <section class="project-overview" id="overview">
        <div class="wrap overview-layout">
          <div class="overview-label"><p class="eyebrow" data-i18n="project.section">PROJECT FILE</p><span>{project.number} — <span data-i18n="project.detailsSuffix">DETAILS</span></span></div>
          <div class="overview-main">
            <h2 data-i18n-html="project.heading">The problem.<br /><em>The decisions.</em></h2>
            <p class="overview-description" data-i18n={`projects.${project.slug}.description`}>{project.description.en}</p>
            <div class="detail-grid">
              {project.details.map((detail, index) => (
                <article class="detail-item">
                  <span class="detail-index">0{index + 1}</span>
                  <h3 data-i18n={`projects.${project.slug}.details.${index}.title`}>{detail.title.en}</h3>
                  <p data-i18n={`projects.${project.slug}.details.${index}.text`}>{detail.text.en}</p>
                </article>
              ))}
            </div>
            <div class="stack-row"><span class="eyebrow" data-i18n="project.technologyLabel">TECHNOLOGIES</span><div>{project.stack.map((item) => <span class="stack-chip">{item}</span>)}</div></div>
          </div>
        </div>
      </section>
      <section class="project-next wrap">
        <div><p class="eyebrow" data-i18n="project.next">NEXT PROJECT</p><a href={`/projects/${nextProject.slug}/`}><span class="next-name">{nextProject.name}</span><span class="next-arrow">↗</span></a></div>
        <a class="back-link" href="/#proyectos" data-i18n="project.all">← All projects</a>
      </section>
    </main>
    <footer class="site-footer wrap">
      <a class="wordmark" href="/" aria-label="Back to home" data-i18n-aria="brand.backLabel"><span class="wordmark-mark"><BrandMark /></span><span>GABRIEL MARTÍN MORAN</span></a>
      <span data-i18n="footer.meta">BUENOS AIRES, AR · SOURCE: PUBLIC</span>
      <a href="#overview"><span data-i18n="project.top">BACK TO TOP</span> ↑</a>
    </footer>
  </div>
</SiteLayout>
