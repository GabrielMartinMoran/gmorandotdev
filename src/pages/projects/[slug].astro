---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import { projects } from '../../data/projects';
import { getCanonical, getLocaleUrls, getProjectStructuredData } from '../../data/seo';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const nextProject = projects[(projects.findIndex((item) => item.slug === project.slug) + 1) % projects.length];
const localeUrls = getLocaleUrls(`projects/${project.slug}`);
const canonical = getCanonical(localeUrls.en);
const structuredData = getProjectStructuredData(project, 'en', canonical);
---

<SiteLayout
  title={project.seoTitle.en}
  description={project.seoDescription.en}
  titleKey={`projects.${project.slug}.titleTag`}
  descriptionKey={`projects.${project.slug}.seoDescription`}
  locale="auto"
  alternateUrls={localeUrls}
  structuredData={structuredData}
>
  <ProjectDetail project={project} nextProject={nextProject} locale="en" />
</SiteLayout>
