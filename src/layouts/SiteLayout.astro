---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  titleKey: string;
  descriptionKey: string;
}

const { title, description, titleKey, descriptionKey } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} data-i18n-content={descriptionKey} />
    <meta name="theme-color" content="#08070d" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — Gabriel Martín Moran`} data-i18n-content={titleKey} />
    <meta property="og:description" content={description} data-i18n-content={descriptionKey} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <title data-i18n={titleKey}>{title} — Gabriel Martín Moran</title>
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/i18n';
    </script>
  </body>
</html>
