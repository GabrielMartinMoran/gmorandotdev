---
import { agentSkills, skillInstallCommand } from '../data/agent-skills';
import { getCopy } from '../data/ui-copy';

type Skill = (typeof agentSkills)[number];
const { skill, index, locale = 'en' } = Astro.props as { skill: Skill; index: number; locale?: 'en' | 'es' };
const installCommand = skillInstallCommand(skill.slug);
const skillUrl = `https://github.com/GabrielMartinMoran/skills/tree/main/skills/${skill.slug}`;
---

<article class="skill-card">
  <div class="skill-card-top">
    <span class="card-number">{String(index + 1).padStart(2, '0')} / <span data-i18n="skills.cardType">{getCopy(locale, 'skills.cardType')}</span></span>
    <a class="skill-repo-link" href={skillUrl} target="_blank" rel="noreferrer" aria-label={getCopy(locale, 'skills.open')} data-i18n-aria="skills.open">↗</a>
  </div>
  <h3>{skill.name}</h3>
  <p data-i18n={`skills.${skill.slug}.description`}>{skill.description[locale]}</p>
  <div class="skill-install">
    <div class="skill-install-head">
      <span class="skill-install-label" data-i18n="skills.installLabel">{getCopy(locale, 'skills.installLabel')}</span>
      <button class="copy-command" type="button" data-copy-command={installCommand} aria-label={getCopy(locale, 'skills.copyAria')} data-i18n-aria="skills.copyAria">
        <span data-copy-label aria-live="polite" data-i18n="skills.copyCommand">{getCopy(locale, 'skills.copyCommand')}</span>
      </button>
    </div>
    <code>{installCommand}</code>
  </div>
</article>
