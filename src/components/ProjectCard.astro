---
interface Project {
  slug: string;
  number: string;
  name: string;
  eyebrow: { en: string; es: string };
  summary: { en: string; es: string };
  accent: string;
  mark: string;
}

const { project, locale = 'en' } = Astro.props as { project: Project; locale?: 'en' | 'es' };
const homePath = locale === 'es' ? '/es' : '';
---

<article class={`project-card ${project.accent}`}>
  <div class="card-topline">
    <span class="card-number">{project.number} / <span data-i18n="project.cardType">PROJECT</span></span>
    <span class="card-mark" aria-hidden="true">{project.mark}</span>
  </div>
  <p class="eyebrow" data-i18n={`projects.${project.slug}.eyebrow`}>{project.eyebrow[locale]}</p>
  <h3>{project.name}</h3>
  <p class="card-summary" data-i18n={`projects.${project.slug}.summary`}>{project.summary[locale]}</p>
  <a class="text-link" href={`${homePath}/projects/${project.slug}/`}>
    <span data-i18n="project.cardLink">{locale === 'es' ? 'Ver el proyecto' : 'Explore project'}</span> <span aria-hidden="true">↗</span>
  </a>
</article>
